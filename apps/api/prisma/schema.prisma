generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
/// BLÉR ONE
/// Kernel Foundation v3
////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
/// ENUMS
////////////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum FileVisibility {
  PRIVATE
  COMPANY
  PUBLIC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OrganizationType {
  HOLDING
  BUSINESS_GROUP
  FRANCHISOR
  ASSOCIATION
  COOPERATIVE
  PRIVATE_COMPANY
  PUBLIC_COMPANY
  NON_PROFIT
}

enum CompanyType {
  HEADQUARTERS
  BRANCH
  FRANCHISE
  SUBSIDIARY
  PARTNER
}

enum UnitType {
  STORE
  CLINIC
  OFFICE
  WAREHOUSE
  FACTORY
  LABORATORY
  ONLINE
  CALL_CENTER
}

////////////////////////////////////////////////////////////
/// TENANT
////////////////////////////////////////////////////////////
model Tenant {
  ////////////////////////////////////////////////////////
  // Primary Key
  ////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  ////////////////////////////////////////////////////////
  // Identification
  ////////////////////////////////////////////////////////
  name String
  slug String  @unique
  code String?

  ////////////////////////////////////////////////////////
  // Status
  ////////////////////////////////////////////////////////
  active  Boolean @default(true)
  version Int     @default(1)

  ////////////////////////////////////////////////////////
  // Metadata
  ////////////////////////////////////////////////////////
  metadata Json?

  ////////////////////////////////////////////////////////
  // Audit
  ////////////////////////////////////////////////////////
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedBy String?   @db.Uuid

  ////////////////////////////////////////////////////////
  // Relationships
  ////////////////////////////////////////////////////////
  organizations Organization[]
  companies     Company[]
  units         Unit[]
  users         User[]
  roles         Role[]
  userPermissions UserPermission[]

  ////////////////////////////////////////////////////////
  // Indexes
  ////////////////////////////////////////////////////////
  @@index([slug])
  @@index([active])
  @@index([deletedAt])
  @@index([active, deletedAt])
  @@map("tenants")
}

////////////////////////////////////////////////////////////
/// ORGANIZATION
////////////////////////////////////////////////////////////
model Organization {
  ////////////////////////////////////////////////////////
  // Primary Key
  ////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  ////////////////////////////////////////////////////////
  // Ownership
  ////////////////////////////////////////////////////////
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  ////////////////////////////////////////////////////////
  // Identification
  ////////////////////////////////////////////////////////
  code      String
  name      String
  slug      String
  legalName String?
  document  String?
  type      OrganizationType @default(PRIVATE_COMPANY)

  ////////////////////////////////////////////////////////
  // Internationalization
  ////////////////////////////////////////////////////////
  country  String @default("BR")
  timezone String @default("America/Sao_Paulo")
  locale   String @default("pt-BR")
  language String @default("pt-BR")
  currency String @default("BRL")

  ////////////////////////////////////////////////////////
  // Metadata
  ////////////////////////////////////////////////////////
  metadata Json?

  ////////////////////////////////////////////////////////
  // Status
  ////////////////////////////////////////////////////////
  active  Boolean @default(true)
  version Int     @default(1)

  ////////////////////////////////////////////////////////
  // Audit
  ////////////////////////////////////////////////////////
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedBy String?   @db.Uuid

  ////////////////////////////////////////////////////////
  // Relationships
  ////////////////////////////////////////////////////////
  companies Company[]

  ////////////////////////////////////////////////////////
  // Physical Table & Indexes
  ////////////////////////////////////////////////////////
  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, deletedAt])
  @@index([type])
  @@index([document])
  @@index([name])
  @@index([active])
  @@map("organizations")
}

////////////////////////////////////////////////////////////
/// COMPANY
////////////////////////////////////////////////////////////
model Company {
  ////////////////////////////////////////////////////////
  // Primary Key
  ////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  ////////////////////////////////////////////////////////
  // Ownership
  ////////////////////////////////////////////////////////
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  ////////////////////////////////////////////////////////
  // Identification
  ////////////////////////////////////////////////////////
  code      String
  name      String
  slug      String
  legalName String?
  tradeName String?
  document  String
  type      CompanyType @default(HEADQUARTERS)

  ////////////////////////////////////////////////////////
  // Government Registration
  ////////////////////////////////////////////////////////
  stateRegistration     String?
  municipalRegistration String?

  ////////////////////////////////////////////////////////
  // Internationalization
  ////////////////////////////////////////////////////////
  country      String @default("BR")
  timezone     String @default("America/Sao_Paulo")
  locale       String @default("pt-BR")
  language     String @default("pt-BR")
  currency     String @default("BRL")
  dateFormat   String @default("dd/MM/yyyy")
  numberFormat String @default("pt-BR")

  ////////////////////////////////////////////////////////
  // Metadata
  ////////////////////////////////////////////////////////
  metadata Json?

  ////////////////////////////////////////////////////////
  // Status
  ////////////////////////////////////////////////////////
  active  Boolean @default(true)
  version Int     @default(1)

  ////////////////////////////////////////////////////////
  // Audit
  ////////////////////////////////////////////////////////
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedBy String?   @db.Uuid

  ////////////////////////////////////////////////////////
  // Relationships
  ////////////////////////////////////////////////////////
  units Unit[]

  ////////////////////////////////////////////////////////
  // Constraints & Indexes
  ////////////////////////////////////////////////////////
  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([organizationId])
  @@index([tenantId, active])
  @@index([tenantId, deletedAt])
  @@index([organizationId, active])
  @@index([name])
  @@index([type])
  @@index([active])
  @@map("companies")
}

////////////////////////////////////////////////////////////
/// UNIT
////////////////////////////////////////////////////////////
model Unit {
  ////////////////////////////////////////////////////////
  // Primary Key
  ////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  ////////////////////////////////////////////////////////
  // Ownership
  ////////////////////////////////////////////////////////
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  ////////////////////////////////////////////////////////
  // Identification
  ////////////////////////////////////////////////////////
  code      String
  name      String
  slug      String
  tradeName String?
  type      UnitType @default(STORE)

  ////////////////////////////////////////////////////////
  // Internationalization
  ////////////////////////////////////////////////////////
  country  String @default("BR")
  timezone String @default("America/Sao_Paulo")
  locale   String @default("pt-BR")
  language String @default("pt-BR")
  currency String @default("BRL")

  ////////////////////////////////////////////////////////
  // Metadata
  ////////////////////////////////////////////////////////
  metadata Json?

  ////////////////////////////////////////////////////////
  // Status
  ////////////////////////////////////////////////////////
  active  Boolean @default(true)
  version Int     @default(1)

  ////////////////////////////////////////////////////////
  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedBy String?   @db.Uuid

  //////////////////////////////////////////////////////////
  // Constraints & Indexes
  //////////////////////////////////////////////////////////
  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, active])
  @@index([tenantId, deletedAt])
  @@index([companyId, active])
  @@index([name])
  @@index([type])
  @@index([active])
  @@map("units")
}

///////////////////////////////////////////////////////////////
/// USER
///////////////////////////////////////////////////////////////
model User {
  //////////////////////////////////////////////////////////
  // Primary Key
  //////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  //////////////////////////////////////////////////////////
  // Ownership
  //////////////////////////////////////////////////////////
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  roleId String? @db.Uuid
role   Role?   @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  //////////////////////////////////////////////////////////
  // Identification
  //////////////////////////////////////////////////////////
  firstName    String
  lastName     String
  email        String
  username     String?
  passwordHash String

  //////////////////////////////////////////////////////////
  // Status
  //////////////////////////////////////////////////////////
  status        UserStatus @default(ACTIVE)
  active        Boolean    @default(true)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  version       Int        @default(1)

  //////////////////////////////////////////////////////////
  // Audit
  //////////////////////////////////////////////////////////
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  createdBy String?    @db.Uuid
  updatedBy String?    @db.Uuid
  deletedBy String?    @db.Uuid
  userPermissions UserPermission[]

  //////////////////////////////////////////////////////////
  // Constraints & Indexes
  //////////////////////////////////////////////////////////
  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([status])
  @@index([active])
  @@index([deletedAt])
  @@index([lastLoginAt])
  @@map("users")
  @@index([roleId])
}

////////////////////////////////////////////////////////////
/// ROLE
////////////////////////////////////////////////////////////
model Role {
  //////////////////////////////////////////////////////////
  // Primary Key
  //////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  //////////////////////////////////////////////////////////
  // Ownership
  //////////////////////////////////////////////////////////
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  //////////////////////////////////////////////////////////
  // Identification
  //////////////////////////////////////////////////////////
  name String
  slug String

  //////////////////////////////////////////////////////////
  // Status
  //////////////////////////////////////////////////////////
  active  Boolean @default(true)
  version Int     @default(1)

  //////////////////////////////////////////////////////////
  // Audit
  //////////////////////////////////////////////////////////
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedBy String?   @db.Uuid

  //////////////////////////////////////////////////////////
  // Relationships
  //////////////////////////////////////////////////////////
  users User[]
  rolePermissions RolePermission[]

  //////////////////////////////////////////////////////////
  // Constraints & Indexes
  //////////////////////////////////////////////////////////
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([active])
  @@index([deletedAt])

  @@map("roles")
}

////////////////////////////////////////////////////////////
/// PERMISSION
////////////////////////////////////////////////////////////

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([code])
  @@map("permissions")
}

////////////////////////////////////////////////////////////
/// ROLE PERMISSION
////////////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])

  @@index([roleId])
  @@index([permissionId])

  @@map("role_permissions")
}
model UserPermission {
  //////////////////////////////////////////////////////////
  // Primary Key
  //////////////////////////////////////////////////////////
  id String @id @default(uuid()) @db.Uuid

  //////////////////////////////////////////////////////////
  // Ownership
  //////////////////////////////////////////////////////////
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  //////////////////////////////////////////////////////////
  // Relationships
  //////////////////////////////////////////////////////////
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  //////////////////////////////////////////////////////////
  // Permission
  //////////////////////////////////////////////////////////
  allowed Boolean @default(true)

  //////////////////////////////////////////////////////////
  // Audit
  //////////////////////////////////////////////////////////
  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////////
  // Constraints & Indexes
  //////////////////////////////////////////////////////////
  @@unique([userId, permissionId])
  @@index([tenantId])
  @@index([userId])
  @@index([permissionId])

  @@map("user_permissions")
}